{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revectorai-support",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
}
